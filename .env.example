# ==============================
# 小倩 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ==============================

# 应用
APP_NAME=小倩
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库
DATABASE_URL=postgresql+asyncpg://xiaoqian:xiaoqian123@localhost:5432/xiaoqian_db
SYNC_DATABASE_URL=postgresql+psycopg2://xiaoqian:xiaoqian123@localhost:5432/xiaoqian_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (DashScope / OpenAI 兼容)
LLM_API_KEY=your-api-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
EMBED_MODEL=text-embedding-v3

# 搜索 API
TAVILY_API_KEY=your-tavily-api-key

# 天气 API (和风天气)
QWEATHER_API_KEY=your-qweather-api-key

# 阿里云短信 (SMS)
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
SMS_SIGN_NAME=小倩助手
SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# Chroma 向量数据库
CHROMA_PERSIST_DIR=./chroma_data

# 定时任务 (每日检索触发时间，24小时制)
DAILY_TRIGGER_HOUR=8
DAILY_TRIGGER_MINUTE=30

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
